# ---------------------------------------------------------------------------
# Contact form email delivery (OPTIONAL).
# Without these, the contact form gracefully falls back to a prefilled mailto:
# link, so the site works with zero configuration.
#
# To enable real email delivery:
#   1. Create a free account at https://resend.com
#   2. Add & verify a domain, then create an API key.
#   3. Copy this file to `.env.local` and fill in the values below.
# ---------------------------------------------------------------------------

# Resend API key (server-only, never exposed to the client).
RESEND_API_KEY=

# The address the contact form sends to (your inbox).
CONTACT_TO_EMAIL=akashmadduru@gmail.com

# The verified "from" address on your Resend domain.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Public canonical site URL (used for SEO metadata, sitemap, OG images).
NEXT_PUBLIC_SITE_URL=https://akashmadduru.dev
